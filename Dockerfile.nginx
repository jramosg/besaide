# syntax=docker/dockerfile:1
FROM nginx:alpine

# Use the exact Node build, including its server-island encryption key.
# The app context is supplied by Compose or the deployment workflow.
COPY --from=app /app/dist/client /usr/share/nginx/html

# Copy nginx config
COPY nginx.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
